<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainTracker.App.Pages.ProfilePage"
             Title="حسابي"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Ink}" Spacing="0">
            <VerticalStackLayout Padding="22,16,22,18" Spacing="2">
                <Label Text="حسابي" Style="{StaticResource Display}" TextColor="White" />
                <Label Text="بياناتك والإعدادات" TextColor="#AFC0CE" FontSize="14" />
            </VerticalStackLayout>
            <BoxView HeightRequest="4" Color="{StaticResource Signal}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="14">

                <Border Padding="18,16" StrokeThickness="1" Stroke="{StaticResource Rule}"
                        BackgroundColor="{StaticResource Ticket}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="الاسم اللي هيظهر مع بلاغاتك" Style="{StaticResource Caption}" />
                        <Entry x:Name="NameEntry" Placeholder="اسمك (اختياري)" FontFamily="Plex" />
                        <Button Text="حفظ" Clicked="OnSave" />
                        <Label x:Name="SavedLabel" IsVisible="False" Text="اتحفظ." TextColor="{StaticResource Go}"
                               FontFamily="PlexBold" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18,16" StrokeThickness="1" Stroke="{StaticResource Rule}"
                        BackgroundColor="{StaticResource Ticket}" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="عن التطبيق" FontFamily="PlexBold" />
                        <Label x:Name="IdLabel" Style="{StaticResource Caption}" />
                        <Label x:Name="VersionLabel" Style="{StaticResource Caption}" />
                        <Label x:Name="ServerLabel" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
