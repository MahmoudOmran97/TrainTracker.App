<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Platform}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Plex" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- رقم القطر والأوقات: خط كوفي زي لافتات المحطات -->
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="Kufi" />
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style x:Key="Time" TargetType="Label">
        <Setter Property="FontFamily" Value="Kufi" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="PlexBold" />
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="22,10" />
    </Style>
</ResourceDictionary>
