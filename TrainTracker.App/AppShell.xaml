<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:TrainTracker.App.Pages"
       x:Class="TrainTracker.App.AppShell"
       FlowDirection="RightToLeft"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       BackgroundColor="{StaticResource Ink}">

    <!-- شريط التنقل بتاعنا هو Controls/BottomBar جوه كل صفحة، فشريط Shell الأصلي مخفي -->
    <TabBar>
        <ShellContent Title="الرئيسية" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="البحث" Route="search" ContentTemplate="{DataTemplate pages:SearchPage}" />
        <ShellContent Title="حسابي" Route="profile" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>
</Shell>
